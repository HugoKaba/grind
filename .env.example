# Référence des variables d'environnement (committée, sans secret réel).
# Copier en `.env` et adapter. `.env` est gitignored.

# Base de données. Vide → SQLite en mémoire (dev sans Docker).
DATABASE_URL=postgres://grind:grind@localhost:5432/grind

# Cache Redis. Vide → cache désactivé (NoopCache).
REDIS_URL=redis://localhost:6379

# Secret de signature des sessions JWT (générer une valeur forte en prod).
JWT_SECRET=change-me-in-production

# Adresse d'écoute du serveur Leptos.
LEPTOS_SITE_ADDR=127.0.0.1:3000
