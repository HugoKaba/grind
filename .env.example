# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=grind
DB_USER=grind_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Django Settings
DEBUG=True
# Generate one: python -c "import secrets,string; print(''.join(secrets.choice('abcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*(-_=+)') for _ in range(50)))"
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Redis
REDIS_URL=redis://localhost:6379/1

# Email (Optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Security (set all to True in production, behind HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
